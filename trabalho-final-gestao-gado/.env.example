# Copie este arquivo para ".env" e preencha com valores reais.
# O ".env" nunca deve ser commitado (já está no .gitignore).

# ============================================
# SERVIDOR
# ============================================
PORT=3000

# Fuso horário do processo Node — define em que fuso "hoje"/"agora" são
# calculados (idade do animal, validação de data futura, seed automático,
# etc). Sem isso, o processo roda no fuso do sistema operacional (UTC dentro
# do container Docker), o que pode adiantar/atrasar "hoje" em algumas horas.
TZ=America/Sao_Paulo

# ============================================
# POSTGRESQL
# ============================================
# Usados pelo docker-compose.yml para configurar o container do banco.
# Fora do Docker, servem só de referência — quem o app/Prisma realmente
# usa é a DATABASE_URL abaixo.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=troque-por-uma-senha-forte
DB_NAME=gestao_gado

# ============================================
# PRISMA ORM
# ============================================
# Monte a partir dos valores acima: postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?schema=public
DATABASE_URL="postgresql://postgres:troque-por-uma-senha-forte@localhost:5432/gestao_gado?schema=public"

# ============================================
# JWT
# ============================================
# Gere um valor aleatório e forte, ex.: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-forte

# ============================================
# SEED AUTOMÁTICO
# ============================================
# Roda o seed de dados de exemplo sozinho quando sobe o servidor e o banco
# está vazio (nenhum usuário/animal cadastrado). Defina "false" para
# desativar esse comportamento.
AUTO_SEED=true
