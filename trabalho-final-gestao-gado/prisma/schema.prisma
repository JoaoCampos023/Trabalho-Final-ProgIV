generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUM: PAPEL DO USUÁRIO
// ============================================
enum Role {
  Admin
  Cliente
}

// ============================================
// MODEL: USUÁRIO
// ============================================
model User {
  id          String   @id @default(uuid())
  nome        String   @db.VarChar(100)
  email       String   @unique @db.VarChar(100)
  senha_hash  String   @db.VarChar(255)
  cpf         String   @unique @db.VarChar(14)
  ativo       Boolean  @default(true)
  role        Role     @default(Cliente)
  criado_em   DateTime @default(now())
  atualizado_em DateTime @updatedAt

  @@map("users")
}

// ============================================
// MODEL: ANIMAL
// ============================================
model Animal {
  brinco          Int      @id
  nome            String   @db.VarChar(50)
  sexo            String   @db.Char(1)
  raca            String?  @db.VarChar(50)
  peso            Decimal? @db.Decimal(10, 2)
  data_nascimento DateTime @db.Date
  ativo           Boolean  @default(true)
  brinco_pai      Int?
  brinco_mae      Int?
  criado_em       DateTime @default(now())
  atualizado_em   DateTime @updatedAt

  // Relacionamentos para árvore genealógica
  pai        Animal?           @relation("Pai", fields: [brinco_pai], references: [brinco])
  mae        Animal?           @relation("Mae", fields: [brinco_mae], references: [brinco])
  filhos_pai Animal[]          @relation("Pai")
  filhos_mae Animal[]          @relation("Mae")

  producoes  ProducaoLeite[]

  @@map("animais")
}

// ============================================
// MODEL: PRODUÇÃO DE LEITE
// ============================================
model ProducaoLeite {
  id             Int      @id @default(autoincrement())
  animal_brinco  Int
  data_coleta    DateTime @db.Date
  litros         Decimal  @db.Decimal(10, 2)
  periodo        String   @db.VarChar(10)
  criado_em      DateTime @default(now())
  atualizado_em  DateTime @updatedAt

  animal Animal @relation(fields: [animal_brinco], references: [brinco], onDelete: Cascade)

  @@map("producoes_leite")
}